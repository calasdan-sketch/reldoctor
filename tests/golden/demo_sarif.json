          "ruleIndex": 7,
          "level": "error",
          "message": {
            "text": "'acme_widgets/settings.py' contains what looks like a Stripe live key (value not shown); it would be public on PyPI. If this is a deliberate test fixture, exempt it with --allow-path"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "acme_widgets-1.0.0-cp312-cp312-manylinux2014_x86_64.whl"
                }
              }
            }
          ],
          "partialFingerprints": {
            "reldoctor/v1": "6b56ea21bafa77883a5103ccc9a4665a"
          }
        },
